{
    // Text shown in the status bar for the current file's code owner. Wrap any
    // of these keys in braces to have it replaced with the resolved rule's
    // values:
    //
    //   {owners}          every owner on the rule, comma separated
    //   {owner}           just the first owner, when the bar is tight
    //   {comment}         the comment above the rule, flattened onto one line
    //   {pattern}         the glob pattern that matched
    //   {line_number}     the line the rule is on in its CODEOWNERS file
    //   {codeowners_file} path to the CODEOWNERS file the rule came from
    //
    // A key with nothing to say, such as {comment} on a rule with no comment
    // above it, renders as nothing and the surrounding whitespace is tidied up,
    // so one template works for every rule. A key that is misspelled is left in
    // place rather than silently blanked. Set this to "" to hide the status bar.
    //
    // A key may be made conditional: {key?text} includes the literal text only
    // when the key has a value, and drops it when it does not. That is how the
    // default template keeps the dash beside {comment} when there is a comment
    // and omits it when there is not, instead of leaving a stray dash behind.
    "status_bar_template": "Code Owner: {comment? - }{owners}",

    // When true, the default-branch diff command refreshes the local
    // origin/<default> tracking ref before computing the diff, so the result
    // reflects the real remote baseline. This is network-bound (a few seconds
    // per invocation) and blocks the UI thread only briefly since the work
    // runs asynchronously.

    // When false, the command uses the local origin/<default> ref as-is. This
    // is fast but can be stale if the remote has moved since the last fetch,
    // in which case unrelated default-branch commits may surface as if they
    // were this branch's changes. Useful when offline or when speed matters
    // more than freshness.
    "fetch_remote_default_branch": true
}